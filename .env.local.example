# ===========================================
# Frontend Environment Variables (Next.js)
# ===========================================

# ML Service URL - Flask/Render service for fraud detection
# 
# IMPORTANT: You MUST use NEXT_PUBLIC_ prefix for Vercel!
# Without this prefix, the variable won't be available in the browser.
#
# In Vercel Dashboard → Settings → Environment Variables:
#   Name: NEXT_PUBLIC_ML_API_URL
#   Value: https://ml-file-for-url.onrender.com
#   Environments: Production, Preview, Development
#
NEXT_PUBLIC_ML_API_URL=https://ml-file-for-url.onrender.com

# For local development with local Flask:
# NEXT_PUBLIC_ML_API_URL=http://localhost:5000


# ===========================================
# Backend API URL - Node.js/Express server
# ===========================================
#
# IMPORTANT: You MUST use NEXT_PUBLIC_ prefix for Vercel!
# This connects the frontend to your backend API
#
# For production (when you deploy backend to Render/Railway/etc):
NEXT_PUBLIC_BACKEND_URL=https://your-backend-service.onrender.com

# For local development:
# NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
